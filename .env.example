# ─────────────────────────────────────────────────────────────────────
# CSC Result Complaint Portal — Environment Configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` at the project root and fill in your values.
# DO NOT commit the real `.env` file — it contains credentials.
# Lines starting with # are comments. Quotes are optional around values.
# ─────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────
# Default values below match XAMPP/MAMP/Laragon out of the box.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=csc_portal
DB_USER=root
DB_PASS=

# ── Application ─────────────────────────────────────────────────────
APP_NAME=Csc Complaint Portal
APP_VERSION=1.0.0

# "local" shows all errors. "production" hides errors and logs them.
APP_ENV=local

# Africa/Lagos is the project's natural timezone.
APP_TIMEZONE=Africa/Lagos

# BASE_URL is auto-detected from the request. Set this only if you need
# to force a specific URL (e.g. for CLI scripts or behind a reverse proxy).
# Examples:
#   BASE_URL=http://localhost:8000/
#   BASE_URL=https://portal.lasu.edu.ng/
#   BASE_URL=https://myapp.example.com/uniportal/
#BASE_URL=

# ── API Keys ────────────────────────────────────────────────────────
# Get a Groq key at https://console.groq.com (free tier available)
GROQ_API_KEY=

# Get a PDF.co key at https://app.pdf.co (free tier: 100 credits/month)
PDFCO_API_KEY=

# ── OTP / Email Verification ────────────────────────────────────────
# Codes are stored in the `otp_codes` table and emailed via PHPMailer
# (see includes/mailer.php). Configure SMTP below — Brevo is the
# recommended free-tier provider (300 emails/day free, no domain
# verification needed for testing). See README for setup guide.
OTP_EXPIRY_MINUTES=15
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# ── SMTP / Email Provider (PHPMailer) ───────────────────────────────
# Set MAIL_DRIVER=smtp to use PHPMailer with the SMTP server below.
# Set MAIL_DRIVER=mail  to use PHP's built-in mail() (fallback).
# Set MAIL_DRIVER=log   to log the email body to error_log instead of sending
#                       (useful for tests without a real SMTP account).
MAIL_DRIVER=smtp

# ── Brevo SMTP (recommended — free 300/day) ─────────────────────────
# Get your SMTP key at: https://app.brevo.com/settings/keys/smtp
# (Generate an "SMTP Key" — it looks like a long string starting with
#  'xkeys-ib-...' or similar. Don't use your Brevo login password.)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-verified-sender@lasu.edu.ng
SMTP_PASSWORD=your-brevo-smtp-key-here
SMTP_ENCRYPTION=tls

# Other providers (just change SMTP_HOST/PORT/ENCRYPTION):
#   Gmail:        smtp.gmail.com:587 tls    (use a 16-char App Password)
#   Mailtrap:     sandbox.smtp.mailtrap.io:2525 tls (testing only)
#   SendGrid:     smtp.sendgrid.net:587 tls  (username: "apikey", password: your API key)
#   Mailgun:      smtp.mailgun.org:587 tls
#   Amazon SES:   email-smtp.<region>.amazonaws.com:587 tls

# ── From: / Reply-To addresses ──────────────────────────────────────
# The From: address MUST be a verified sender in your Brevo account
# (or any provider's sender list). Log in to Brevo → Senders & IP →
# Add the email address and confirm it.
MAIL_FROM=no-reply@lasu.edu.ng
MAIL_FROM_NAME=CSC Portal
MAIL_REPLY_TO=no-reply@lasu.edu.ng

# ── Business Rules ──────────────────────────────────────────────────
MIN_UNITS=18
MAX_UNITS=26
SLA_HOURS=72
SESSION_TIMEOUT=3600

# ── Maintenance Mode ─────────────────────────────────────────────────
# Set to true to redirect all visitors to maintenance.php
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=lasu
