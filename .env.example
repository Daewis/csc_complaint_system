# ─────────────────────────────────────────────────────────────────────
# LASU Result Complaint Portal — Environment Configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to `.env` at the project root and fill in your values.
# DO NOT commit the real `.env` file — it contains credentials.
# Lines starting with # are comments. Quotes are optional around values.
# ─────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────
# Default values below match XAMPP/MAMP/Laragon out of the box.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lasu_uniportal
DB_USER=root
DB_PASS=

# ── Application ─────────────────────────────────────────────────────
APP_NAME=LASU Result Complaint Portal
APP_VERSION=1.0.0

# "local" shows all errors. "production" hides errors and logs them.
APP_ENV=local

# Africa/Lagos is the project's natural timezone.
APP_TIMEZONE=Africa/Lagos

# BASE_URL is auto-detected from the request. Set this only if you need
# to force a specific URL (e.g. for CLI scripts or behind a reverse proxy).
# Examples:
#   BASE_URL=http://localhost:8000/
#   BASE_URL=https://portal.lasu.edu.ng/
#   BASE_URL=https://myapp.example.com/uniportal/
#BASE_URL=

# ── API Keys ────────────────────────────────────────────────────────
# Get a Groq key at https://console.groq.com (free tier available)
GROQ_API_KEY=

# Get a PDF.co key at https://app.pdf.co (free tier: 100 credits/month)
PDFCO_API_KEY=

# ── OTP / Email Verification ────────────────────────────────────────
# Codes are stored in the `otp_codes` table and emailed via PHP mail().
# Set up SMTP (or use a host with mail() enabled) to deliver real codes.
OTP_EXPIRY_MINUTES=15
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
MAIL_FROM=no-reply@lasu.edu.ng
MAIL_FROM_NAME=LASU Result Complaint Portal

# ── Business Rules ──────────────────────────────────────────────────
MIN_UNITS=18
MAX_UNITS=26
SLA_HOURS=72
SESSION_TIMEOUT=3600

# ── Maintenance Mode ─────────────────────────────────────────────────
# Set to true to redirect all visitors to maintenance.php
MAINTENANCE_MODE=false
MAINTENANCE_SECRET=lasu
