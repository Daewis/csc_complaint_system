{
    "name": "lasu/uniportal",
    "description": "CSC Result Complaint Portal — academic complaint management system",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "phpmailer/phpmailer": "^7.1",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "echo '--- CSC Result Complaint Portal ---'",
            "echo 'Dependencies installed. Next steps:'",
            "echo '  1. cp .env.example .env'",
            "echo '  2. Edit .env with your DB + SMTP credentials'",
            "echo '  3. Import database/schema.sql into MySQL'",
            "echo '  4. php -S localhost:8000'",
            "echo '  5. Visit http://localhost:8000/login.php'"
        ]
    }
}
